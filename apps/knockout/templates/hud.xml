<frame pos="-159. 40." z-index="0">
	<quad pos="0. 0." size="54. {{ bg_height }}." halign="left" valign="top"
		style="Bgs1InRace" substyle="BgCardSystem" opacity="0.85" />

	<!-- title -->
	<label pos="27. -1.5." size="50. 4." halign="center" valign="top"
		textsize="2" textfont="GameFontBlack" textcolor="FFFFFF" text="{{ match_text }}" />

	<!-- header stats -->
	<label pos="2. -7." size="34. 3." halign="left" valign="top"
		textsize="1" textfont="GameFontSemiBold" textcolor="FFFFFF" text="ROUND" />
	<label pos="52. -7." size="20. 3." halign="right" valign="top"
		textsize="1" textfont="GameFontSemiBold" textcolor="FFCC00" text="{{ round_text }}" />

	<label pos="2. -11." size="34. 3." halign="left" valign="top"
		textsize="1" textfont="GameFontSemiBold" textcolor="FFFFFF" text="PLAYERS" />
	<label pos="52. -11." size="20. 3." halign="right" valign="top"
		textsize="1" textfont="GameFontSemiBold" textcolor="FFCC00" text="{{ players_count }}" />

	<label pos="2. -15." size="28. 3." halign="left" valign="top"
		textsize="1" textfont="GameFontSemiBold" textcolor="FFFFFF" text="KOS PER ROUND" />
	<label pos="52. -15." size="24. 3." halign="right" valign="top"
		textsize="1" textfont="GameFontSemiBold" textcolor="FFCC00" text="{{ ko_text }}" />

	<!-- header divider -->
	<quad pos="2. -18.6." size="50. 0.2." halign="left" valign="top" bgcolor="FFFFFF" opacity="0.4" />

	{% if has_divider %}
	<quad pos="2. {{ divider_y }}." size="50. 0.25." halign="left" valign="top" bgcolor="FF3333" opacity="0.7" />
	{% endif %}

	{% for row in rows %}
	{% if row.gap %}
	<label pos="27. {{ row.y }}." size="50. 3.5." halign="center" valign="top"
		textsize="1" textcolor="AAAAAA" text="• • •" />
	{% else %}
	<label pos="2. {{ row.y }}." size="6. 3.5." halign="left" valign="top"
		textsize="1" textcolor="{{ row.name_color }}" text="{{ row.rank }}" />
	<label pos="8. {{ row.y }}." size="32. 3.5." halign="left" valign="top"
		textsize="1" textcolor="{{ row.name_color }}" text="{{ row.name }}" />
	<label pos="52. {{ row.y }}." size="18. 3.5." halign="right" valign="top"
		textsize="1" textcolor="{{ row.time_color }}" text="{{ row.time }}" />
	{% endif %}
	{% endfor %}
</frame>
